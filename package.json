{
  "name": "laquila-sync",
  "version": "1.0.0",
  "description": "Sincroniza o dropshipping da Laquila com Bling e Shopify",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "worker": "node dist/src/worker.js",
    "migrate": "node dist/src/lib/migrate.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "node dist/src/cli.js"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "bullmq": "^6.7.10",
    "fast-xml-parser": "^5.12.1",
    "fastify": "^5.12.8",
    "ioredis": "^6.1.0",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "undici": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
