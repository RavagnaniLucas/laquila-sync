# Copie para .env DENTRO DA VPS e preencha. Nunca commitar o .env nem colar no chat.
NODE_ENV=production
LOG_LEVEL=info
PUBLIC_HOST=sync.sualoja.com.br
PUBLIC_URL=https://sync.sualoja.com.br
# Gere com: openssl rand -hex 24
ADMIN_TOKEN=
# Gere com: openssl rand -hex 24  (repita o mesmo valor na DATABASE_URL abaixo)
POSTGRES_PASSWORD=
DATABASE_URL=postgres://laquila:COLE_A_SENHA_AQUI@postgres:5432/laquila
REDIS_URL=redis://redis:6379

# --- Laquila (deixe desligado até receber o token) ---
LAQUILA_ENABLED=false
LAQUILA_TOKEN=
LAQUILA_CPF_CNPJ_CONSULTA=
LAQUILA_CD_TRANSPORTADOR=

# --- Bling v3 (app criado no Bling) ---
BLING_ENABLED=false
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_DEPOSITO_ID=

# --- Shopify (app do Dev Dashboard) ---
SHOPIFY_ENABLED=false
SHOPIFY_SHOP=sualoja.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_LOCATION_ID=

# --- Regras de preço e estoque (ajuste com as suas respostas) ---
PRICE_MARKUP=1.8
PRICE_MIN_MARGIN=0.25
PRICE_FIXED_COST=8
PRICE_ENDING=0.9
MAP_BRANDS=TEXX,HJC
STOCK_SAFETY=2
STOCK_MAX_SHOWN=50
